TARGETNAME=FakeNetFilter
TARGETTYPE=DRIVER
DRIVERTYPE=WDM

# Target OS version
_NT_TARGET_VERSION=$(_NT_TARGET_VERSION_WIN10)

# Include paths
INCLUDES=$(DDK_INC_PATH)

# Source files
SOURCES= \
    FakeNetFilter.c \
    TriggerLayer.c \
    DetectionLayer.c \
    DeceptionLayer.c \
    LoggingLayer.c \
    ExtractionLayer.c \
    ControlLayer.c

# Libraries
TARGETLIBS=$(DDK_LIB_PATH)\ntoskrnl.lib \
           $(DDK_LIB_PATH)\hal.lib \
           $(DDK_LIB_PATH)\wdfldr.lib

# Compiler flags
MSC_WARNING_LEVEL=/W4 /WX
C_DEFINES=$(C_DEFINES) -DUNICODE -D_UNICODE

# Driver entry point
DRIVERENTRY=DriverEntry

